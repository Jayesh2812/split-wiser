rules_version = '2';

// Splitwiser security rules.
//
// Model:
//   groups/{groupId}               - one doc per shared group; memberUids gates access
//   invites/{code}                 - tiny lookup doc mapping an invite code to a groupId
//   public_settlements/{token}      - frozen, WORLD-READABLE settlement summary
//   public_settlement_refs/{token}  - token -> groupId; readable by these rules only
//
// Deploy with:  npm run rules:deploy   (firebase deploy --only firestore:rules)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() && request.auth.uid in resource.data.memberUids;
    }

    function isOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Settlement mode is group-wide and the owner's call, so it is the one field
    // an ordinary member may not touch. Enforced here and not only in the UI:
    // `allow update: if isMember()` lets any member rewrite the whole document,
    // which would make a client-side check decoration rather than a control.
    function touchesGreedy() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['greedy']);
    }

    // Joining: you may append ONLY your own uid, and may only touch the two
    // membership fields. Knowing the groupId is the capability — it is only
    // obtainable from a valid invite code.
    function isJoiningSelf() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members']);
    }

    // The group a published-settlement token belongs to. Read from a document no
    // client may read: rules-side get()/exists() are evaluated independently of
    // the accessed document's own read rules.
    function settlementGroupId(token) {
      return get(/databases/$(database)/documents/public_settlement_refs/$(token)).data.groupId;
    }

    function isGroupOwner(gid) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(gid)).data.ownerUid == request.auth.uid;
    }

    // The published payload allowlist, enforced here as well as in the client so
    // no future refactor can leak inviteCode, memberUids, ownerUid, member ids,
    // uids, transactions or notes into a world-readable document.
    function validSettlement() {
      return request.resource.data.keys().hasOnly(
               ['v', 'name', 'currency', 'publishedAt', 'mode', 'totals', 'balances', 'transfers'])
        && request.resource.data.keys().hasAll(
               ['v', 'name', 'currency', 'publishedAt', 'mode', 'totals', 'balances', 'transfers'])
        && request.resource.data.v == 1
        && request.resource.data.mode in ['direct', 'greedy']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.currency is string
        && request.resource.data.currency.size() <= 8
        // `is number`, not `is int`: a rejected publish surfaces as an opaque
        // permission error, and this field is a display stamp, not a guard.
        && request.resource.data.publishedAt is number
        && request.resource.data.totals is map
        // Generous sanity bounds on a world-readable document. buildSnapshot
        // enforces the string limits above, so the client cannot trip these.
        && request.resource.data.balances is list
        && request.resource.data.balances.size() <= 500
        && request.resource.data.transfers is list
        && request.resource.data.transfers.size() <= 5000;
    }

    match /groups/{groupId} {
      // Creator must include themselves as a member.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.ownerUid == request.auth.uid;

      allow read: if isMember();
      // Members may rewrite members/memberUids/transactions wholesale, which a
      // member merge requires: it folds one person into another and has to
      // rewrite every transaction that referenced the old id. `greedy` is the
      // exception — owner only. isJoiningSelf() already limits itself to the two
      // membership fields, so it cannot reach greedy either.
      allow update: if (isMember() && (isOwner() || !touchesGreedy())) || isJoiningSelf();
      // Only the owner can destroy the group for everyone.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /invites/{code} {
      // Any signed-in user may resolve a code they were given.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      // The creator may refresh the cached group name (shown in join prompts).
      // Nothing else is writable — the groupId mapping is immutable.
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName']);
    }

    // A frozen settlement summary the group owner chose to share. Readable by
    // anyone holding the token, including signed-out visitors.
    match /public_settlements/{token} {
      // Anyone may fetch a token they were given...
      allow get: if true;
      // ...but nobody may enumerate them. `allow read` would grant list as well,
      // and one query would return every published settlement in the database.
      allow list: if false;

      // Only the owner of the group behind this token may write it. The groupId
      // comes from the ref doc, never from this world-readable one.
      allow create, update: if isGroupOwner(settlementGroupId(token)) && validSettlement();
      allow delete: if isGroupOwner(settlementGroupId(token));
    }

    // token -> groupId. Written by the owner, readable by NO client — only by the
    // rules above. Deliberately not merged into public_settlements: a groupId in a
    // world-readable doc would let any signed-in stranger satisfy isJoiningSelf()
    // and join the group, which then grants read access to every transaction.
    match /public_settlement_refs/{token} {
      allow get, list: if false;

      allow create: if isGroupOwner(request.resource.data.groupId)
        && request.resource.data.keys().hasOnly(['groupId'])
        && request.resource.data.groupId is string;
      // Re-pointing a live token at another group is never legitimate, and would
      // let the owner of group B overwrite group A's published page.
      allow update: if isGroupOwner(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isGroupOwner(resource.data.groupId);
    }
  }
}
