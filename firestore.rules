rules_version = '2';

// Splitwiser security rules.
//
// Model:
//   groups/{groupId}  - one doc per shared group; memberUids gates access
//   invites/{code}    - tiny lookup doc mapping an invite code to a groupId
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() && request.auth.uid in resource.data.memberUids;
    }

    // Joining: you may append ONLY your own uid, and may only touch the two
    // membership fields. Knowing the groupId is the capability — it is only
    // obtainable from a valid invite code.
    function isJoiningSelf() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members']);
    }

    match /groups/{groupId} {
      // Creator must include themselves as a member.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.ownerUid == request.auth.uid;

      allow read: if isMember();
      allow update: if isMember() || isJoiningSelf();
      // Only the owner can destroy the group for everyone.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /invites/{code} {
      // Any signed-in user may resolve a code they were given.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      // The creator may refresh the cached group name (shown in join prompts).
      // Nothing else is writable — the groupId mapping is immutable.
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName']);
    }
  }
}
