{
  "name": "splitwiser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first PWA expense splitter with greedy settlement and PDF/CSV export.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "rules:emulate": "firebase emulators:start --only firestore",
    "firebase": "firebase"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "firebase-admin": "^13.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^13.29.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
