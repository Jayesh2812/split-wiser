# Firebase config — OPTIONAL.
#
# Without these, Splitwiser runs exactly as before: fully offline, solo groups
# only, no sign-in. Fill them in to unlock Google login + shared groups.
#
# 1. Create a project at https://console.firebase.google.com
# 2. Build > Authentication > Sign-in method > enable Google
# 3. Build > Firestore Database > Create database (production mode)
# 4. Project settings > General > Your apps > Web app -> copy the config below
# 5. Copy this file to `.env.local` and paste your values
# 6. Deploy the rules:  firebase deploy --only firestore:rules
#
# Note: these keys are public by design (they identify, not authorise).
# Access is enforced by firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — not a VITE_ variable, never exposed to the browser.
#
# Set this in your HOST's environment (e.g. Vercel > Settings > Environment
# Variables), not in .env.local, and treat it as a password: a service account
# bypasses firestore.rules completely.
#
# It powers api/member-emails.ts, which fills in the addresses of members who
# have not opened the app since emails started being stored. Without it that
# endpoint reports itself unconfigured and emails are typed in by hand.
#
# Firebase console > Project settings > Service accounts > Generate new private
# key, then paste the WHOLE JSON file as the value.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
