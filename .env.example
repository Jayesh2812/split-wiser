# Firebase config — OPTIONAL.
#
# Without these, Splitwiser runs exactly as before: fully offline, solo groups
# only, no sign-in. Fill them in to unlock Google login + shared groups.
#
# 1. Create a project at https://console.firebase.google.com
# 2. Build > Authentication > Sign-in method > enable Google
# 3. Build > Firestore Database > Create database (production mode)
# 4. Project settings > General > Your apps > Web app -> copy the config below
# 5. Copy this file to `.env.local` and paste your values
# 6. Deploy the rules:  firebase deploy --only firestore:rules
#
# Note: these keys are public by design (they identify, not authorise).
# Access is enforced by firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
